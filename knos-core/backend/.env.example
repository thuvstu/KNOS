# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://knos:your_password@localhost:5432/knos
DB_PASSWORD=your_password

# ─── Gemini (Google AI Studio) ──────────────────────────────
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSION=768
LLM_MODEL=gemini-2.5-flash

# ─── Ollama (optional local LLM) ────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ─── Cloudflare Access (personal cloud) ─────────────────────
# CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_AUD=your-audience-tag

# ─── Feature flags ──────────────────────────────────────────
DEBUG=false
AUTO_CONNECT_ENABLED=false
AUTO_CONNECT_THRESHOLD=0.82
EMBEDDING_MAX_RPM=10

# ─── External APIs (optional) ───────────────────────────────
# YOUTUBE_API_KEY=

# ─── Storage ────────────────────────────────────────────────
KNOS_BLOB_DIR=/home/knos/blobs
